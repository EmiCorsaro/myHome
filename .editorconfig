root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,json,css,html,yml,yaml,md}]
indent_size = 2

[*.{cs,csproj,props,targets,slnx}]
indent_size = 4

[*.cs]
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# EF Core writes these files and rewrites them on every `migrations add`. They are generated code:
# the project's style and quality rules do not apply to them, and without this every new migration
# would have to be hand-edited to get past TreatWarningsAsErrors. Hand-editing a migration that has
# already been applied somewhere is exactly what must never happen.
[**/Persistence/Migrations/*.cs]
generated_code = true

[*.md]
trim_trailing_whitespace = false
