<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The modular monolith's boundaries, as executable tests.

    They exist from the first commit on purpose: they are written while there is still nothing
    violating them. Adding them after twenty screens exist is an archaeology exercise.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Api\Api.csproj" />
    <ProjectReference Include="..\..\src\Modules.Ledger\Modules.Ledger.csproj" />
    <ProjectReference Include="..\..\src\Modules.Shared\Modules.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
