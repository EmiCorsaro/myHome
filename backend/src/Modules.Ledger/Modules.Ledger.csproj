<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Ledger module, whole: its public contracts and its implementation.

    Two namespaces are published. Contracts/ holds the data contracts — the shapes the module
    exchanges. Application/Interfaces holds the service interfaces, beside the Application/Services
    that fulfil them.

    That second one is public API sitting inside the implementation layer, so the namespace no
    longer marks the boundary: visibility does. Every service is internal, which leaves the
    interfaces as the only types an outside assembly can reach. ModuleBoundaryTests enforces it,
    and that test is the whole reason the arrangement is safe — do not delete it.

    The contracts used to be a separate project. The separation was dropped on purpose: with a
    single module there was nobody it could protect, while every new DTO still cost a decision
    about which project it belonged in.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Modules.Shared\Modules.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

</Project>
